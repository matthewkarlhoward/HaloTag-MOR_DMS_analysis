# Class network script: Antagonist LOF
# Two-model layout (#1 translucent cartoon, #2 opaque spheres)

close session
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif

hide ~/R
hide solvent
hide ligand

cartoon #1/R
hide #1/R target a
color #1/R #a8a8a8
color #1/R #a8a8a8 transparency 75

~cartoon #2
hide #2/R target a

set bgColor white
lighting soft
lighting shadows false
graphics silhouettes true

open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_attributes/lof_antagonist_count.defattr

sel #2/R:100,165,167,175,176,177,178,180,183,185,217,236,257,271,275,277,278,279,280,282,288,291,298,320,336,347@CA
show sel target a
style sel sphere
size sel atomRadius 1.1
color sel #6f08a3
~sel
open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_pseudobonds/classes_merged/lof_antagonist.pb
open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_pseudobonds/classes_interactions_merged/lof_antagonist_hbonds.pb
open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_pseudobonds/classes_interactions_merged/lof_antagonist_pi.pb
label #2/R:175,278,183,100,236,275,277 residues text "{0.number}" height 2.6 color black bgColor white
2dlabels text "Antagonist — LOF  (26 residues, 27 edges)" xpos 0.04 ypos 0.94 size 22 color black
view matrix camera 0.270015,-0.078762,0.959629,283.278195,0.962548,0.047287,-0.266956,91.245077,-0.024352,0.995771,0.088581,170.109358
zoom 0.78
