# Class network script: Weak GOF
# Two-model layout (#1 translucent cartoon, #2 opaque spheres)

close session
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif

hide ~/R
hide solvent
hide ligand

cartoon #1/R
hide #1/R target a
color #1/R #a8a8a8
color #1/R #a8a8a8 transparency 75

~cartoon #2
hide #2/R target a

set bgColor white
lighting soft
lighting shadows false
graphics silhouettes true

open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_attributes/gof_weak_count.defattr

sel #2/R:119,139,148,223@CA
show sel target a
style sel sphere
size #2/R:139@CA atomRadius 0.55
size #2/R:223@CA atomRadius 0.662
size #2/R:148@CA atomRadius 0.869
size #2/R:119@CA atomRadius 0.966
color sel #3779b9
~sel
open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_pseudobonds/classes_merged/gof_weak.pb
label #2/R:119,148,223,139 residues text "{0.number}" height 2.6 color black bgColor white
view matrix camera 0.270015,-0.078762,0.959629,283.278195,0.962548,0.047287,-0.266956,91.245077,-0.024352,0.995771,0.088581,170.109358
turn y -5
view #1/R
zoom 1.6
