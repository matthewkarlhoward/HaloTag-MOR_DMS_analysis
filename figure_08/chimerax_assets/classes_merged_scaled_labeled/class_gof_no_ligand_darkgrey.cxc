# Class network script: No Ligand GOF
# Two-model layout (#1 translucent cartoon, #2 opaque spheres)

close session
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif

hide ~/R
hide solvent
hide ligand

cartoon #1/R
hide #1/R target a
color #1/R #a8a8a8
color #1/R #a8a8a8 transparency 75

~cartoon #2
hide #2/R target a

set bgColor white
lighting soft
lighting shadows false
graphics silhouettes true

open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_attributes/gof_no_ligand_count.defattr

sel #2/R:96,99,107,119,133,148,152,154,156,160,161,162,177,179,180,209,221,222,223,225,226,230,238,254,261,265,267,269,274,283,287,295,322,327,328,330,331,339,341,343@CA
show sel target a
style sel sphere
size #2/R:99,133,148,154,156,161,162,179,209,222,226,230,238,254,261,265,267,269,283,322,327,328,330,339@CA atomRadius 0.55
size #2/R:96,107,177,180,221,225,274,295,331,341@CA atomRadius 0.966
size #2/R:119,160@CA atomRadius 1.316
size #2/R:223,287@CA atomRadius 1.625
size #2/R:343@CA atomRadius 2.161
size #2/R:152@CA atomRadius 2.4
color sel #888888
~sel
open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_pseudobonds/classes_merged/gof_no_ligand.pb
open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_pseudobonds/classes_interactions_merged/gof_no_ligand_hbonds.pb
open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_pseudobonds/classes_interactions_merged/gof_no_ligand_pi.pb
label #2/R:152,343,223,287,119,160,96 residues text "{0.number}" height 2.6 color black bgColor white
view matrix camera 0.270015,-0.078762,0.959629,283.278195,0.962548,0.047287,-0.266956,91.245077,-0.024352,0.995771,0.088581,170.109358
turn y -5
view #1/R
zoom 1.6
