# Class network script: Intermediate GOF
# Two-model layout (#1 translucent cartoon, #2 opaque spheres)

close session
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif

hide ~/R
hide solvent
hide ligand

cartoon #1/R
hide #1/R target a
color #1/R #a8a8a8
color #1/R #a8a8a8 transparency 75

~cartoon #2
hide #2/R target a

set bgColor white
lighting soft
lighting shadows false
graphics silhouettes true

open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_attributes/gof_intermediate_count.defattr

sel #2/R:127,223,225,343@CA
show sel target a
style sel sphere
size #2/R:223,225@CA atomRadius 0.55
size #2/R:343@CA atomRadius 0.698
size #2/R:127@CA atomRadius 0.836
color sel #9b1c1d
~sel
open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_pseudobonds/classes_merged/gof_intermediate.pb
open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_pseudobonds/classes_interactions_merged/gof_intermediate_pi.pb
label #2/R:127,343,223,225 residues text "{0.number}" height 2.6 color black bgColor white
view matrix camera 0.270015,-0.078762,0.959629,283.278195,0.962548,0.047287,-0.266956,91.245077,-0.024352,0.995771,0.088581,170.109358
turn y -5
view #1/R
zoom 1.6
