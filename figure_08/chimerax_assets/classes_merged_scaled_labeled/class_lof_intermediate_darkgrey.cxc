# Class network script: Intermediate LOF
# Two-model layout (#1 translucent cartoon, #2 opaque spheres)

close session
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif

hide ~/R
hide solvent
hide ligand

cartoon #1/R
hide #1/R target a
color #1/R #a8a8a8
color #1/R #a8a8a8 transparency 75

~cartoon #2
hide #2/R target a

set bgColor white
lighting soft
lighting shadows false
graphics silhouettes true

open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_attributes/lof_intermediate_count.defattr

sel #2/R:73,77,98,99,100,105,115,116,120,122,126,145,146,149,152,153,154,156,157,164,167,170,171,175,176,177,178,180,181,182,183,238,239,242,246,249,254,257,261,273,277,278,279,280,291,295,298,299,302,321,323,324,327,328,330,331,334@CA
