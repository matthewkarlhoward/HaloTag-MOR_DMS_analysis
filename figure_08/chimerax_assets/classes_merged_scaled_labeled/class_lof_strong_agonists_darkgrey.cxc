# Class network script: Strong Agonists LOF
# Two-model layout (#1 translucent cartoon, #2 opaque spheres)

close session
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif
open /Users/mkh/GitHub/mor_dms_analysis/structures/raw/experimental/8efq.cif

hide ~/R
hide solvent
hide ligand

cartoon #1/R
hide #1/R target a
color #1/R #a8a8a8
color #1/R #a8a8a8 transparency 75

~cartoon #2
hide #2/R target a

set bgColor white
lighting soft
lighting shadows false
graphics silhouettes true

open /Users/mkh/GitHub/mor_dms_analysis/network_tools/chimerax_attributes/lof_strong_agonists_count.defattr

