# ─── Matchmaker alignment to 8efq receptor ──────────────────
matchmaker #2-37 to #1/R alg sw matrix BLOSUM-62 ssFraction 0.3

# ─── Delete non-reference receptor protein, keep ligands ─────
delete #2 & protein & /A
delete #3 & protein & /A
delete #4 & protein & /R
delete #5 & protein & /R
delete #6 & protein & /R
delete #7 & protein & /D
delete #8 & protein & /R
delete #9 & protein & /D
delete #10 & protein & /D
delete #11 & protein & /D
delete #12 & protein & /A
delete #13 & protein & /R
delete #14 & protein & /R
delete #15 & protein & /A
delete #16 & protein & /R
delete #17 & protein & /R
delete #18 & protein & /R
delete #19 & protein & /R
delete #20 & protein & /R
delete #21 & protein & /R
delete #22 & protein & /R
delete #23 & protein & /R
delete #24 & protein & /R
