delete #26 & protein & /R
delete #27 & protein & /R
delete #28 & protein & /R
delete #29 & protein & /R
delete #30 & protein & /R
delete #31 & protein & /R
delete #32 & protein & /R
delete #33 & protein & /R
delete #34 & protein & /R
delete #35 & protein & /R
delete #36 & protein & /R
delete #37 & protein & /D

# ─── Render ─────────────────────────────────────────────────
# Reference receptor as cartoon
hide #1 atoms
show #1 cartoon
color #1 #DDDDDD
transparency #1 60 cartoon

# Hide cartoon on non-reference (only ligands remain)
hide #2-37 cartoon
hide #2-37 ribbon

# Show every remaining atom (ligands) as sticks
show #2-37 atoms
style #2-37 stick

# Peptide ligand on reference (DAMGO) also as sticks
show #1/P atoms
style #1/P stick

# ─── Color each ligand uniquely ─────────────────────────────
color #1/P #E6194B
color #2 #3CB44B  # 4dkl
color #3 #FFE119  # 5c1m
color #4 #4363D8  # 6dde
color #5 #F58231  # 6ddf
color #6 #911EB4  # 7sbf
color #7 #46F0F0  # 7scg
color #8 #F032E6  # 7t2g
color #9 #BCF60C  # 7t2h
color #10 #FABEBE  # 7u2k
color #11 #008080  # 7u2l
color #12 #E6BEFF  # 7ul4
color #13 #9A6324  # 8Y72
color #14 #FFFAC8  # 8Y73
color #15 #800000  # 8e0g
color #16 #AAFFC3  # 8ef5
color #17 #808000  # 8ef6
color #18 #FFD8B1  # 8efb
color #19 #000075  # 8efl
color #20 #808080  # 8efo
color #21 #FF1493  # 8f7q
color #22 #00CED1  # 8f7r
color #23 #FF8C00  # 8k9k
color #24 #8A2BE2  # 8k9l
color #25 #00FA9A  # 9MQI
color #26 #DC143C  # 9ODL
color #27 #1E90FF  # 9PXU
color #28 #FFD700  # 9PXW
color #29 #7B68EE  # 9PY2
color #30 #20B2AA  # 9PY3
color #31 #FF6347  # 9PY4
color #32 #4682B4  # 9WST
color #33 #D2691E  # 9WSV
color #34 #9ACD32  # 9WSW
color #35 #BA55D3  # 9WSX
color #36 #CD5C5C  # 9bjk
color #37 #5F9EA0  # 9bqj

# Recolor heteroatoms by element for clarity
color byhetero

# ─── View ───────────────────────────────────────────────────
view
view #1/R:50-340  # frame on MOR transmembrane core

# ─── Done ───────────────────────────────────────────────────
echo Loaded and aligned 37 MOR structures; non-reference receptors stripped, ligands overlaid.
